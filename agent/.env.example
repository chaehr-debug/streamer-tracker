# setup.ps1 이 자동으로 만들어 줍니다. 직접 만들 때만 참고하세요.
WORKER_URL=https://streamer-tracker.coach-draft-game.workers.dev
AGENT_SECRET=관리자에게_받은_값

# 선택 항목
# AGENT_NAME=사이트에 표시될 이 PC 이름 (기본: PC 이름)
# AGENT_PLATFORMS=twitch            (비우면 치지직+트위치 전부 처리)
# CHROME_PATH=C:\경로\chrome.exe    (자동으로 못 찾을 때만)
# CDP_PORT=9222                     (다른 프로그램과 포트가 겹칠 때만)
